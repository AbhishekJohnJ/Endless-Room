{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": ".",
  "publicBase": "./",
  "headers": [
    {
      "source": "/(.*)\\.(glb|mp3|png|jpg|jpeg)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/(?!.*\\.(glb|mp3|png|jpg|jpeg|gif|css|js|json|ico|svg|woff|woff2|ttf|eot)$)(.*)",
      "dest": "/index.html"
    }
  ]
}
